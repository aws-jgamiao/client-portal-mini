# Client Portal Mini - copy to .env.local and fill in.
#
# Only the PUBLISHABLE (anon) key belongs here. This app never uses the
# service-role / secret key, and it must never be added to Vercel.
#
# Local development (`npx supabase start` prints these):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Base URL used in password-reset and invitation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "true" shows demo sign-in buttons and the reset-demo control.
NEXT_PUBLIC_DEMO_MODE=true
